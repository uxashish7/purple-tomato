# Purple Tomato — Environment Variables Template
#
# Usage (local dev):
#   flutter run --dart-define-from-file=.env
#   flutter build web --dart-define-from-file=.env
#
# Copy this file to `.env`, fill in your values, then add .env to .gitignore.
# NEVER commit .env to version control.

# ── Upstox API ──────────────────────────────────────────────────────────────
# Get from: https://developer.upstox.com/ → create an UpLink App
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=https://purple-tomato-lyart.vercel.app/callback

# ── Google Gemini ────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/ → Create API key
GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://app.supabase.com/ → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ── Alpha Vantage (optional) ─────────────────────────────────────────────────
# Free API key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
